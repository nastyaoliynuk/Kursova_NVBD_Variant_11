  <MdxScripts>
    <MdxScript dwd:design-time-name="6dd949a3-5953-49e0-a6ae-c653701d1f72">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].Total_Accrued
 AS [Measures].[Base Salary]+[Measures].[Extra Salary], 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].Salary_After_Tax
 AS [Measures].[Total Accrued]-[Measures].[Tax], 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].Average_Salary
 AS [Measures].[Net Salary]/[Measures].[Fact Payroll Accrual Count], 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].Vacation_Usage
 AS [Measures].[Used Days]/[Measures].[Total Days], 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>